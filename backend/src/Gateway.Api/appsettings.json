{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/products-api/{**catch-all}"
        },
        "Metadata": {
          "AntiforgeryRequired": "true"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/products-api"
          }
        ],
        "AuthorizationPolicy": "default"
      },
      "stocks-route": {
        "ClusterId": "stocks-cluster",
        "Match": {
          "Path": "/stocks-api/{**catch-all}"
        },
        "Metadata": {
          "AntiforgeryRequired": "true"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/stocks-api"
          }
        ],
        "AuthorizationPolicy": "default"
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/payments-api/{**catch-all}"
        },
        "Metadata": {
          "AntiforgeryRequired": "true"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/payments-api"
          }
        ],
        "AuthorizationPolicy": "default"
      },
      "angular-spa-fallback": {
        "ClusterId": "angular-cluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "products-cluster": {
        "Destinations": {
          "products-cluster-destination": {
            "Address": "http://products-api"
          }
        }
      },
      "stocks-cluster": {
        "Destinations": {
          "stocks-cluster-destination": {
            "Address": "http://stocks-api"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payments-cluster-destination": {
            "Address": "http://localhost/"
          }
        }
      },
      "angular-cluster": {
        "Destinations": {
          "dev-server": {
            "Address": "http://localhost:4200/"
          }
        }
      }
    }
  },
  "Keycloak": {
    "AuthorizationUrl": "https://localhost:8080/realms/shoppinessrealm/protocol/openid-connect/auth",
    "TokenUrl": "https://localhost:8080/realms/shoppinessrealm/protocol/openid-connect/token"
  },
  "Authentication": {
    "MetadataAddress": "https://keycloak:8080/realms/shoppinessrealm/.well-known/openid-configuration",
    "ValidIssuer": "https://localhost:8080/realms/shoppinessrealm",
    "Audience": "account",
    "OpenIdConnect": {
      "Authority": "https://localhost:8080/realms/shoppinessrealm",
      "ClientId": "shoppinessclient",
      "ClientSecret": ""
    }
  },
  "JAEGER_OTLP_ENDPOINT": "http://jaeger:4317",
  "BFF": {
    "FrontendOrigin": "http://localhost:4200"
  }
}
